# Copy this file to .env and adjust the values.
# JWT_SECRET MUST match the NEXTAUTH_SECRET from web/.env so the service
# can verify NextAuth session tokens.

HOST=0.0.0.0
PORT=8080

DATABASE_URL=postgres://postgres:password@localhost:5432/toolkit
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=replace-with-your-web-NEXTAUTH_SECRET

# Comma-separated list of allowed browser origins (e.g. http://localhost:3000).
# If unset, CORS is permissive (development only).
# CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info
