{
  "expo": {
    "name": "ToolKit",
    "slug": "toolkit-mobile",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "scheme": "toolkit",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f5f2",
      "dark": { "backgroundColor": "#17151f" }
    },
    "ios": {
      "supportsTablet": true,
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp", "NSPrivacyAccessedAPITypeReasons": ["0A2A.1", "3B52.1", "C617.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime", "NSPrivacyAccessedAPITypeReasons": ["35F9.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace", "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"] }
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "ToolKit uses the camera only when you choose to capture post or message media.",
        "NSPhotoLibraryUsageDescription": "ToolKit accesses selected photos and videos for posts, profiles, and messages.",
        "NSFaceIDUsageDescription": "ToolKit can use Face ID to lock the app when you enable biometric lock."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f7f5f2",
        "monochromeImage": "./assets/notification-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      "expo-sharing",
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#ed4b4b" }],
      "expo-local-authentication",
      "expo-video",
      ["expo-camera", { "cameraPermission": "Allow ToolKit to capture media you choose to share." }],
      ["expo-image-picker", { "photosPermission": "Allow ToolKit to select photos and videos you choose to share." }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://127.0.0.1:3000/api/v1",
      "messageServiceUrl": "http://127.0.0.1:8080",
      "easProjectId": "00000000-0000-0000-0000-000000000000"
    }
  }
}
