DATABASE_URL="postgresql://postgres:password@localhost:5432/toolkit"

# Auth (required for sign in / sign up to work)
# Generate a secret with: `openssl rand -base64 32`
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL="http://192.168.1.100:3000"

# OAuth providers (optional — sign in buttons for unconfigured providers will fail)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Messaging microservice (browser-facing base URL)
NEXT_PUBLIC_MESSAGE_SERVICE_URL=/message-service
MESSAGE_SERVICE_INTERNAL_URL=http://127.0.0.1:8080

# Object storage (S3-compatible — MinIO for dev, Cloudflare R2 for prod)
# Dev (docker compose MinIO, credentials defined in docker-compose.yml):
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=toolkit-media
S3_FORCE_PATH_STYLE=true
#
# Prod (Cloudflare R2):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<R2-access-key-id>
# S3_SECRET_ACCESS_KEY=<R2-secret-access-key>
# S3_BUCKET=toolkit-media
# S3_FORCE_PATH_STYLE=true

# AI tool search (Gemini API key from https://ai.google.dev)
GEMINI_API_KEY=""
# Optional: enable Google web-search grounding (paid/quota-gated feature).
# Leave unset/false to use the fast ungrounded model which works on all keys.
# GEMINI_WEB_SEARCH=true
# Generic authenticated SMTP for account and moderation mail.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ToolKit <support@example.com>"
PUBLIC_APP_URL="http://localhost:3000"

# Local-only configurable content policy (comma-separated terms).
CONTENT_BLOCKED_TERMS=""
CONTENT_MAX_LINKS="4"
