generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  image         String?
  emailVerified DateTime?
  password      String?
  bio           String?
  location      String?
  role          String?
  skills        String[]
  tag           String?      @unique
  accounts      Account[]
  sessions      Session[]
  collections   Collection[]
  posts         Post[]
  likes         Like[]
  comments      Comment[]
  saves         SavedPost[]
  followingRel  Follow[] @relation("UserFollowing")
  followersRel  Follow[] @relation("UserFollowers")
  notifications Notification[] @relation("UserNotifications")
  notifiedActions Notification[] @relation("UserNotificationActors")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  followers     BigInt       @default(0)
  following     BigInt       @default(0)
}

model Collection {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tools       Tool[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Tool {
  id           String     @id @default(cuid())
  name         String
  link         String?
  icon         String     @default("sparkles")
  logoUrl      String?
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([collectionId])
}

model Post {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  caption   String      @default("")
  tags      String[]
  media     PostMedia[]
  likes     Like[]
  comments  Comment[]
  saves     SavedPost[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model PostMedia {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  url    String
  type   String @default("image")
  order  Int    @default(0)
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId])
}

model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String
  type      String
  postId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor     User     @relation("UserNotificationActors", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String @id
  userId       String
  expires      DateTime
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
